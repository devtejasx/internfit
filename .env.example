# Copy to .env.local for local development. Never commit real values.

# Required: Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: model id (default gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Required to view /stats: any long random string you choose
STATS_KEY=replace-with-a-long-random-string

# Optional abuse/cost limits
RATE_LIMIT_PER_10MIN=8
DAILY_ANALYSIS_CAP=500

# Production analytics storage. Set automatically on Vercel when a Blob store
# is connected to the project. Leave unset locally to log events to .data/events.jsonl
# BLOB_READ_WRITE_TOKEN=
